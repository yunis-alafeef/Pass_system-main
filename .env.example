# ================= Frontend Environment (EXAMPLE) =================
# Copy this file to `.env` and adjust the values for your environment.
#   PowerShell:  Copy-Item .env.example .env

# API base URL.
# - Development: '/api' is proxied by the Vite dev server to the NestJS backend.
# - Production: set to the full public API URL, e.g. 'https://api.pass-system.ye/api'
VITE_API_URL=/api

# WebSocket (Socket.IO) base URL for real-time seat updates.
# Leave empty to use the same origin (recommended in development & production).
VITE_WS_URL=

# Force the demo (mock) mode even if the backend is reachable.
# Useful for UI previews and offline development.
VITE_USE_MOCK_API=false