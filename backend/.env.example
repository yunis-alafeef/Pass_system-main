# Server
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pass_system

# Prisma Database URL
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://${REDIS_HOST}:${REDIS_PORT}"

# Authentication
JWT_SECRET="super_secret_jwt_key_here_change_in_production"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="super_secret_refresh_key_here_change_in_production"
JWT_REFRESH_EXPIRATION="7d"

# Payment Gateways (Placeholder)
KURAIMI_API_KEY=""
KURAIMI_MERCHANT_ID=""
TADAMON_API_KEY=""
JAWWAL_API_KEY=""
STRIPE_SECRET_KEY=""
